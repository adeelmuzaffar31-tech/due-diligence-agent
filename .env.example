# ============================================================
# LLM Provider — switch between Claude and GPT
# ============================================================

# Which provider to use. Options: "anthropic" (Claude) or "openai" (GPT)
LLM_PROVIDER=anthropic

# Anthropic (Claude) — get key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT) — get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o

# ============================================================
# Research tools
# ============================================================

# Tavily — get free key at https://tavily.com/ (1000 searches/month free)
TAVILY_API_KEY=tvly-xxxxx
